# ============================================================
# AI Instagram Automation System — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your real values
# NEVER commit .env to version control

# --- Instagram Graph API ---
# Your Instagram Business/Creator account numeric ID
IG_USER_ID=your_instagram_user_id_here

# Long-lived Instagram Graph API access token
# Get from: https://developers.facebook.com/tools/explorer/
IG_ACCESS_TOKEN=your_long_lived_access_token_here

# --- Google Gemini API ---
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# --- Cloudinary (Image Hosting) ---
# Free at: https://cloudinary.com/users/register_free
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# --- News API (Optional supplement) ---
# Free at: https://newsapi.org/register
NEWS_API_KEY=your_newsapi_key_here

# --- Dashboard ---
# Secret key for Flask session security
DASHBOARD_SECRET_KEY=change_this_to_a_random_string
DASHBOARD_PORT=5000

# --- Automation Settings ---
# Account name shown on carousel watermark
IG_ACCOUNT_NAME=@your_account_name

# Whether to actually post to Instagram (set to false for dry runs)
LIVE_MODE=false

# Delay in seconds between posting each of the 5 carousels
POST_DELAY_SECONDS=120
